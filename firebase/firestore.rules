rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Gegenstände: jeder Nutzer sieht/bearbeitet nur eigene Items
    match /items/{itemId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Kundendaten & Versicherung: 1 Dokument pro Nutzer, Doc-ID = userId
    match /customerInfo/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Kategorien: 1 Dokument pro Nutzer, Doc-ID = userId
    match /categories/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
